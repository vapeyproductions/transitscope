FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/api:/app/worker \
    DATA_DIR=/app/data \
    APP_ENV=production \
    WORKER_MODE=live \
    RUN_LIVE_PIPELINE=false \
    AUTO_POPULATE_MANIFEST=false \
    WORKER_HEARTBEAT_SECONDS=15 \
    WORKER_ERROR_RETRY_SECONDS=30 \
    LIVE_POLL_SECONDS=300 \
    TARGET_UNIVERSE_SIZE=126000 \
    STAGE1_BATCH_SIZE=32 \
    STAGE1_MAX_WORKERS=8 \
    STAGE1_POOL_SIZE=500 \
    STAGE1_REFRESH_TARGETS=8 \
    STAGE1_PROMOTION_THRESHOLD=100 \
    STAGE2_PROMOTION_THRESHOLD=25 \
    STAGE3_EVALUATIONS_PER_CYCLE=4 \
    CATALOG_MAX_ROWS=10000 \
    TOP_N_DISPLAY=500 \
    MAX_HISTORY_SECTORS=8 \
    MAST_UNIVERSE_SECTORS=1-26 \
    MAST_UNIVERSE_PER_SECTOR=8000

WORKDIR /app

COPY api/requirements.txt /tmp/api-requirements.txt
COPY worker/requirements.txt /tmp/worker-requirements.txt
RUN pip install --no-cache-dir \
    -r /tmp/api-requirements.txt \
    -r /tmp/worker-requirements.txt

COPY api/app /app/api/app
COPY worker /app/worker
COPY cloud/run_api_worker.py /app/cloud/run_api_worker.py

RUN mkdir -p /app/data

EXPOSE 8000

CMD ["python", "/app/cloud/run_api_worker.py"]

